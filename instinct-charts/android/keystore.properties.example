# انسخ هذا الملف إلى  android/keystore.properties  واملأه بمفتاح التوقيع الخاص بك.
# الملف الحقيقي مستبعَد من Git — لا ترفع مفتاحك أو كلمات مروره إلى المستودع أبدًا،
# وإذا ضاع المفتاح لن تستطيع تحديث التطبيق على المتجر بنفس الحساب.
#
# لإنشاء مفتاح جديد:
#   keytool -genkey -v -keystore instinct-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias instinct

storeFile=../instinct-release.jks
storePassword=
keyAlias=instinct
keyPassword=
